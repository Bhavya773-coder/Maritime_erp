datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  MANAGER
  FLEET_MANAGER
  ACCOUNTS
  STAFF
}

enum TaskType {
  ASSIGNED
  PERSONAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DELEGATED
  COMPLETED
  OVERDUE
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum VesselType {
  BARGE
  TUG
}

enum VesselStatus {
  ACTIVE
  IN_PORT
  MAINTENANCE
  NON_COMPLIANT
}

enum CertificateStatus {
  VALID
  EXPIRING_SOON
  EXPIRED
}

enum VoucherStatus {
  PENDING
  APPROVED
  REJECTED
  INFO_REQUESTED
}

model User {
  id                    String                  @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  email                 String                  @unique
  passwordHash          String                  @map("password_hash")
  role                  Role
  department            String?
  isActive              Boolean                 @default(true) @map("is_active")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  
  tasksCreated          Task[]                  @relation("TaskCreator")
  tasksAssigned         Task[]                  @relation("TaskAssignee")
  delegatedFromLogs     TaskDelegationLog[]     @relation("DelegatedFrom")
  delegatedToLogs       TaskDelegationLog[]     @relation("DelegatedTo")
  vesselsUpdated        Vessel[]                @relation("VesselUpdater")
  vesselLocationHistory VesselLocationHistory[] @relation("LocationUpdater")
  vouchersSubmitted     ExpenseVoucher[]        @relation("VoucherSubmitter")
  vouchersApproved      ExpenseVoucher[]        @relation("VoucherApprover")
  auditLogs             AuditLog[]
  notifications         Notification[]
  taskComments          TaskComment[]
  botMessagesSent       BotMessage[]            @relation("BotMessageSender")
  botMessagesReceived   BotMessage[]            @relation("BotMessageReceiver")
  botReminders          BotReminder[]           @relation("BotReminderAssignee")
  contacts              UserContact[]
  personalReminders     PersonalReminder[]
  vesselActivityLogs    VesselActivityLog[]     @relation("ActivityReporter")
  delayRequestsApproved DelayRequest[]          @relation("DelayApprover")
  delayRequestsRequested DelayRequest[]         @relation("DelayRequester")
  certificationsOwned   Certification[]         @relation("CertificationOwner")

  @@map("users")
}

model Task {
  id           String              @id @default(auto()) @map("_id") @db.ObjectId
  taskType     TaskType            @map("task_type")
  title        String
  description  String?
  createdById  String              @map("created_by_id") @db.ObjectId
  creator      User                @relation("TaskCreator", fields: [createdById], references: [id])
  assignedToId String?             @map("assigned_to_id") @db.ObjectId
  assignee     User?               @relation("TaskAssignee", fields: [assignedToId], references: [id])
  dueDate      DateTime?           @map("due_date")
  priority     Priority
  status       TaskStatus          @default(PENDING)
  completedAt  DateTime?           @map("completed_at")
  deletedAt    DateTime?           @map("deleted_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  isDeleted    Boolean             @default(false) @map("is_deleted")
  acknowledgedAt DateTime?         @map("acknowledged_at")

  delegationLogs TaskDelegationLog[]
  comments       TaskComment[]
  botCommands    BotCommand[]
  botReminders   BotReminder[]
  delayRequests  DelayRequest[]

  @@index([assignedToId])
  @@index([createdById])
  @@index([taskType])
  @@index([status])
  @@index([dueDate])
  @@index([status, dueDate, isDeleted])
  @@map("tasks")
}

model TaskDelegationLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId       String   @map("task_id") @db.ObjectId
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromUserId   String   @map("from_user_id") @db.ObjectId
  fromUser     User     @relation("DelegatedFrom", fields: [fromUserId], references: [id])
  toUserId     String   @map("to_user_id") @db.ObjectId
  toUser       User     @relation("DelegatedTo", fields: [toUserId], references: [id])
  delegatedAt  DateTime @default(now()) @map("delegated_at")
  note         String?

  @@index([taskId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("task_delegation_logs")
}

model TaskComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId    String   @map("task_id") @db.ObjectId
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@index([userId])
  @@map("task_comments")
}

model Vessel {
  id              String                  @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  registrationNo  String                  @unique @map("registration_no")
  type            VesselType
  currentLocation String                  @map("current_location")
  latitude        Float?
  longitude       Float?
  status          VesselStatus
  classification  String?
  buildYear       Int?                    @map("build_year")
  length          Float?
  breadth         Float?
  depth           Float?
  irsIv           String?                 @map("irs_iv")
  remark          String?
  updatedById     String?                 @map("updated_by_id") @db.ObjectId
  updatedBy       User?                   @relation("VesselUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt       DateTime                @updatedAt @map("updated_at")
  deletedAt       DateTime?               @map("deleted_at")

  locationHistory  VesselLocationHistory[]
  certifications   Certification[]
  activityLogs     VesselActivityLog[]
  documents        VesselDocument[]

  @@index([type])
  @@index([status])
  @@index([updatedAt])
  @@map("vessels")
}

model VesselDocument {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  vesselId       String   @map("vessel_id") @db.ObjectId
  vessel         Vessel   @relation(fields: [vesselId], references: [id])
  docType        String   @map("doc_type")
  fileName       String   @map("file_name")
  mimeType       String   @default("application/pdf") @map("mime_type")
  filePath       String?  @map("file_path")  // legacy — kept nullable for migration
  fileDataB64    String?  @map("file_data_b64")  // base64-encoded file bytes (preferred)
  fileSizeBytes  Int?     @map("file_size_bytes")
  description    String?
  uploadedAt     DateTime @default(now()) @map("uploaded_at")

  @@index([vesselId])
  @@index([docType])
  @@map("vessel_documents")
}

model VesselLocationHistory {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  vesselId   String   @map("vessel_id") @db.ObjectId
  vessel     Vessel   @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  location   String
  latitude   Float?
  longitude  Float?
  updatedById String   @map("updated_by_id") @db.ObjectId
  updatedBy  User     @relation("LocationUpdater", fields: [updatedById], references: [id])
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@index([vesselId])
  @@index([updatedById])
  @@map("vessel_location_histories")
}

model Certification {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  vesselId         String?           @map("vessel_id") @db.ObjectId
  vessel           Vessel?             @relation(fields: [vesselId], references: [id], onDelete: SetNull)
  assetType        String?           @map("asset_type")
  certType         String            @map("cert_type")
  certNumber       String            @map("cert_number")
  issuingAuthority String            @map("issuing_authority")
  issueDate        DateTime          @map("issue_date")
  expiryDate       DateTime          @map("expiry_date")
  documentUrl      String?           @map("document_url")
  status           CertificateStatus @default(VALID)
  responsiblePersonId String?        @map("responsible_person_id") @db.ObjectId
  responsiblePerson   User?          @relation("CertificationOwner", fields: [responsiblePersonId], references: [id])
  reminderClosed   Boolean           @default(false) @map("reminder_closed")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  alertLogs        CertAlertLog[]
  certReminderLogs CertReminderLog[]

  @@index([vesselId])
  @@index([certType])
  @@index([status])
  @@index([expiryDate])
  @@index([expiryDate, status])
  @@map("certifications")
}

model CertAlertLog {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  certificateId String        @map("certificate_id") @db.ObjectId
  certificate   Certification @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  alertWindow   Int           @map("alert_window")
  sentAt        DateTime      @default(now()) @map("sent_at")

  @@unique([certificateId, alertWindow])
  @@index([certificateId])
  @@map("cert_alert_logs")
}

model ExpenseVoucher {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  submittedById String        @map("submitted_by_id") @db.ObjectId
  submittedBy   User          @relation("VoucherSubmitter", fields: [submittedById], references: [id])
  expenseType   String        @map("expense_type")
  amount        Float
  expenseDate   DateTime      @map("expense_date")
  vendorName    String        @map("vendor_name")
  description   String?
  receiptUrls   String[]      @map("receipt_urls")
  status        VoucherStatus @default(PENDING)
  approvedById  String?       @map("approved_by_id") @db.ObjectId
  approvedBy    User?         @relation("VoucherApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approverNote  String?       @map("approver_note")
  submittedAt   DateTime      @default(now()) @map("submitted_at")
  actionedAt    DateTime?     @map("actioned_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([submittedById])
  @@index([approvedById])
  @@index([status])
  @@index([expenseType])
  @@index([expenseDate])
  @@index([actionedAt])
  @@map("expense_vouchers")
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @map("user_id") @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}

enum BotChannel {
  WHATSAPP
  INTERNAL_TEST
}

enum BotMessageDirection {
  INCOMING
  OUTGOING
}

enum BotCommandStatus {
  PARSED
  EXECUTED
  NEEDS_CONFIRMATION
  FAILED
}

enum BotReminderType {
  TASK_PENDING
  PERSONAL
}

enum BotReminderStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model UserContact {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  userId      String     @map("user_id") @db.ObjectId
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String     @map("phone_number")
  channel     BotChannel @default(WHATSAPP)
  isVerified  Boolean    @default(false) @map("is_verified")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@unique([userId, phoneNumber, channel])
  @@index([userId])
  @@map("user_contacts")
}

model BotMessage {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  direction         BotMessageDirection
  channel           BotChannel
  fromUserId        String?             @map("from_user_id") @db.ObjectId
  fromUser          User?               @relation("BotMessageSender", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUserId          String?             @map("to_user_id") @db.ObjectId
  toUser            User?               @relation("BotMessageReceiver", fields: [toUserId], references: [id], onDelete: SetNull)
  fromPhone         String?             @map("from_phone")
  toPhone           String?             @map("to_phone")
  rawText           String              @map("raw_text")
  messageType       String              @default("TEXT") @map("message_type")
  status            String              @default("PENDING")
  providerMessageId String?             @map("provider_message_id")
  createdAt         DateTime            @default(now()) @map("created_at")

  botCommands       BotCommand[]

  @@index([fromUserId])
  @@index([toUserId])
  @@index([channel])
  @@index([createdAt])
  @@map("bot_messages")
}

model BotCommand {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  botMessageId  String           @map("bot_message_id") @db.ObjectId
  botMessage    BotMessage       @relation(fields: [botMessageId], references: [id], onDelete: Cascade)
  intent        String
  confidence    Float            @default(1.0)
  parsedJson    Json             @map("parsed_json")
  linkedTaskId  String?          @map("linked_task_id") @db.ObjectId
  linkedTask    Task?            @relation(fields: [linkedTaskId], references: [id], onDelete: SetNull)
  status        BotCommandStatus @default(PARSED)
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([botMessageId])
  @@index([linkedTaskId])
  @@map("bot_commands")
}

model BotReminder {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  taskId         String            @map("task_id") @db.ObjectId
  task           Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignedToId   String            @map("assigned_to_id") @db.ObjectId
  assignedTo     User              @relation("BotReminderAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  reminderType   BotReminderType   @default(TASK_PENDING) @map("reminder_type")
  frequencyHours Int               @default(24) @map("frequency_hours")
  nextReminderAt DateTime          @map("next_reminder_at")
  lastReminderAt DateTime?         @map("last_reminder_at")
  status         BotReminderStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([taskId])
  @@index([assignedToId])
  @@index([status])
  @@index([nextReminderAt])
  @@map("bot_reminders")
}

model VesselActivityLog {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  vesselId      String   @map("vessel_id") @db.ObjectId
  vessel        Vessel   @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  activityType  String   @map("activity_type")
  summary       String
  relatedTaskId String?  @map("related_task_id") @db.ObjectId
  reportedById  String   @map("reported_by_id") @db.ObjectId
  reportedBy    User     @relation("ActivityReporter", fields: [reportedById], references: [id])
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([vesselId])
  @@index([createdAt])
  @@map("vessel_activity_logs")
}

model BotSession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @map("user_id") @db.ObjectId
  state     String
  taskId    String?  @map("task_id") @db.ObjectId
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("bot_sessions")
}

model PersonalReminder {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @map("user_id") @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  remindAt    DateTime @map("remind_at")
  status      String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([status])
  @@index([remindAt])
  @@map("personal_reminders")
}

// ─────────────────────────────────────────────────────────────────────────────
// NEW MODELS ADDED IN PHASE 2
// ─────────────────────────────────────────────────────────────────────────────

model DelayRequest {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  taskId          String    @map("task_id") @db.ObjectId
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedById   String    @map("requested_by_id") @db.ObjectId
  requestedBy     User      @relation("DelayRequester", fields: [requestedById], references: [id])
  proposedDueDate DateTime  @map("proposed_due_date")
  reason          String
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById    String?   @map("approved_by_id") @db.ObjectId
  approvedBy      User?     @relation("DelayApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime? @map("approved_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([taskId])
  @@index([status])
  @@map("delay_requests")
}

model ConversationContext {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  userId               String    @unique @map("user_id") @db.ObjectId
  recentAssetId        String?   @map("recent_asset_id") @db.ObjectId
  recentTaskId         String?   @map("recent_task_id") @db.ObjectId
  pendingConfirmation  String?   @map("pending_confirmation") // JSON string of pending action
  pendingClarification String?   @map("pending_clarification") // e.g. "ambiguous_assignee"
  clarificationData    Json?     @map("clarification_data")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("conversation_contexts")
}

model IdempotencyKey {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  action    String
  status    String   @default("PROCESSING") // PROCESSING, COMPLETED, FAILED
  result    Json?    // Stored result for replay
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_keys")
}

model CertReminderLog {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  certificateId  String        @map("certificate_id") @db.ObjectId
  certificate    Certification @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  alertWindow    Int           @map("alert_window") // 90, 60, 30, 0 (expired), -1 (daily post-30)
  sentToUserId   String?       @map("sent_to_user_id") @db.ObjectId
  sentToPhone    String?       @map("sent_to_phone")
  messageText    String        @map("message_text")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([certificateId])
  @@index([alertWindow])
  @@map("cert_reminder_logs")
}
